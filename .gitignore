# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.whl

# Virtual environment
.venv/

# Data (generated/downloaded — not checked in)
# Belt-and-suspenders: block *.db anywhere, not just in data/, so a DB file
# nested inside a worktree or temp dir can't accidentally get committed.
*.db
*.db-journal
*.db-wal
*.db-shm
data/*.csv
data/*.json
# But DO check in the fitted Boulder+Lead composite weights (Issue #54) —
# the production combined-rating script reads it at startup.
!data/learned_combined_weights.json
*.sqlite
*.sqlite3
# External-ranking cache (Issue #44). Recorded snapshots live in
# tests/fixtures/external_rankings/ and DO ship in-repo; the writable
# cache populated by scripts/refresh_external_rankings.py is local-only.
data/external_rankings/

# Environment
.env
.env.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing / Linting
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# uv
.python-version

# Claude Code worktrees
.claude/worktrees/

# DB snapshots (uploaded to GitHub Releases, not committed)
snapshots/

# Smoke test screenshots (written to /tmp by default; gitignore in case path is changed)
screenshots/
